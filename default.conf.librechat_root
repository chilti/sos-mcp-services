        # ----------------------------------------------------------------------
    # INYECCIÓN DE METADATOS (OPEN GRAPH / WHATSAPP)
    # ----------------------------------------------------------------------
    # Importante: Deshabilitar la compresión desde el backend para que sub_filter funcione
    # Aunque Streamlit ya suele enviar texto plano, es buena práctica.
    proxy_set_header Accept-Encoding "";

    # 1. Reemplaza el título por defecto
    sub_filter '<title>Streamlit</title>' '<title>Dashboard Bibliométrico Topics</title>';

    # 2. Inyecta los tags de Open Graph justo después de <head>
    # Nota: Asegúrate de tener una imagen og_preview.png accesible en esa URL
    sub_filter '<head>' '<head>
    <meta name="description" content="Análisis interactivo de la producción científica.">
    <meta property="og:title" content="Dashboard Bibliométrico Topics">
    <meta property="og:description" content="Análisis interactivo de la producción científica.">
    <meta property="og:url" content="https://dinamica1.fciencias.unam.mx/topics/">
    <meta property="og:type" content="website">
    #<meta property="og:image" content="https://dinamica1.fciencias.unam.mx/revistaslatam/static/og_preview.png">';

    # Asegura que solo se reemplace la primera ocurrencia (para title y head)
    sub_filter_once on;
    # Tipos de contenido donde aplicar el filtro
    sub_filter_types text/html;
    }


