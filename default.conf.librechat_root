
limit_req_zone $binary_remote_addr zone=llm_limit:10m rate=10r/m;

# 1. BLOQUE DE REDIRECCIÓN (Puerto 80)
server {
    listen 80;
    listen [::]:80;
    server_name dinamica1.fciencias.unam.mx;

    # Mantenemos esto para que Certbot pueda renovar el certificado en el futuro
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    # Todo lo que entre por HTTP se envía a HTTPS
    location / {
        return 301 https://$host$request_uri;
    }
}



server {
#    listen 443 ssl;
#    server_name _;

    listen 443 ssl;
    listen [::]:443 ssl;
    server_name dinamica1.fciencias.unam.mx;

    # Rutas exactas donde Certbot guardó los archivos
    ssl_certificate     /etc/letsencrypt/live/dinamica1.fciencias.unam.mx/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/dinamica1.fciencias.unam.mx/privkey.pem;
    
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;

    # Bloque de validación (déjalo para futuras renovaciones)
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    # ------------------------------------------------------------
    # REPORTES INTERACTIVOS FASTMCP (Puerto 8015)
    # ------------------------------------------------------------
    location /reports/ {
        proxy_pass http://127.0.0.1:8015/reports/;
        proxy_http_version 1.1;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_cache off;
        add_header Cache-Control "no-store, no-cache, must-revalidate";
    }

    # ------------------------------------------------------------
    # 1. LIBRECHAT (TEMPORAL EN LA RAÍZ)
    # ------------------------------------------------------------
    location / {
        proxy_pass http://127.0.0.1:3080;
        proxy_http_version 1.1;

        # Soporte para WebSockets
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";

        # Cabeceras estándar de proxy
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Streaming en tiempo real (Server-Sent Events / SSE)
        proxy_buffering off;
        proxy_cache off;

        # Timeouts para modelos extensos (10 minutos)
        proxy_read_timeout 600s;
        proxy_send_timeout 600s;
        proxy_connect_timeout 600s;
        client_max_body_size 100M;
    }

